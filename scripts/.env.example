# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; this template stays committed.

# Elsevier API key (https://dev.elsevier.com/). Required.
SCOPUS_API_KEY=

# Your Scopus author ID. Default below is Ettore Rocchi.
SCOPUS_AUTHOR_ID=57220152522

# Surname + first initial used to bold your name in author lists.
USER_SURNAME=Rocchi
USER_INITIALS=E
